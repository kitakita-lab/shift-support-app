rules_version = '2';

// ★ テスト専用（実環境では使わない）。移行の途中で書き込みが拒否される状況を作る:
//   案件の新しい置き場所（wsProjects）にだけ書けない。それ以外は現在のルールと同じ（ログインしていれば可）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/intention-dev/{coll}/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && coll != 'wsProjects';
    }
  }
}
