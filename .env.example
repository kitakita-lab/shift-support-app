VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# 共有データの置き場所（チーム名）。
# - 本番のビルド（Vercel の Production。VERCEL_ENV=production）: 設定しない（通常のチーム intention-dev になる）。
# - 本番以外（Vercel の Preview・手元）で、実際の Firebase につなぐとき: **必ず**、通常とは別の名前を設定する（例: kkl-preview）。
#   無い・通常のチーム名・使えない形（英小文字で始まる、英小文字・数字・ハイフンの 3〜40 文字以外）のときは、
#   ビルドが失敗し、アプリは Firebase を起動しない（本番のデータには、つながない。src/store/team.ts）。
# - 現在の Firestore ルール（firestore.rules）は intention-dev だけを許可しているため、別の名前の場所は、読み書きできない
#   （ログインすると「登録されていません」と出る。この端末だけのデータと、日報の取得は使える）。
# VITE_TEAM_ID=kkl-preview
